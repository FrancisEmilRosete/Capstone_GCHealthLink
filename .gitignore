# ==============================================================================
# Root .gitignore — GCHealthLink Monorepo
# Covers: Laravel (backend), Next.js (frontend), Python (AI service)
# ==============================================================================

# ------------------------------------------------------------------------------
# OS & Editor
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.fleet/
.nova/
.zed/

# ------------------------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript (shared across frontend & backend assets)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo

# Yarn v3+
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ------------------------------------------------------------------------------
# Next.js (frontend/)
# ------------------------------------------------------------------------------
.next/
out/
.vercel

# ------------------------------------------------------------------------------
# Laravel (new-system/backend-laravel/)
# ------------------------------------------------------------------------------

# Dependencies
vendor/

# Compiled/cached files
*.cache
bootstrap/cache/*.php
storage/*.key

# Laravel-specific storage (not the storage dir itself, just generated content)
storage/pail/
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Public build artifacts
public/build/
public/hot
public/storage

# PHPUnit
.phpunit.cache
.phpunit.result.cache

# IDE helpers
.phpactor.json
_ide_helper*.php
.phpstorm.meta.php

# Homestead / Vagrant
Homestead.json
Homestead.yaml

# Laravel auth
auth.json

# ------------------------------------------------------------------------------
# Python (ai-service-python/)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# mypy
.mypy_cache/

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
.docker/

# ------------------------------------------------------------------------------
# Logs (general)
# ------------------------------------------------------------------------------
logs/
*.log

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
*.pem
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json