APP_NAME=GCHealthLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# AES-256-GCM Transport Encryption
# =============================================================================
# 64-character hex string (32 raw bytes).
# Must be IDENTICAL to NEXT_PUBLIC_AES_SHARED_SECRET in the Next.js .env.local
#
# Generate:  php -r "echo bin2hex(random_bytes(32));"
APP_AES_SECRET=

# =============================================================================
# Database — MySQL / MariaDB
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gchealthlink
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# Logging
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Session & Sanctum — SPA Auth
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# The URL(s) of the Next.js frontend (comma-separated for multiple origins)
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# =============================================================================
# Cache / Queue / Broadcast
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
CACHE_PREFIX=
QUEUE_CONNECTION=database

# =============================================================================
# CORS — Frontend Origin
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AI — Google Gemini
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# AI — Python Microservice
# =============================================================================
AI_SERVICE_URL=http://127.0.0.1:8001

# =============================================================================
# Redis (optional — only if using Redis for cache/queue/session)
# =============================================================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =============================================================================
# Mail (optional — defaults to logging)
# =============================================================================
MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS (optional — only if using S3 for storage)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
